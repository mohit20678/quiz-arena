{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-arena",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUIZ_ROOM", "class_name": "QuizRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuizRoom"] }
  ],
  "vars": {
    "ADMIN_EMAIL": "mohithedau1@gmail.com",
    "ADMIN_SALT_B64": "OWzkPnSCWmY_49bXrL_f2w",
